{
  "name": "@unirate/react",
  "version": "0.1.0",
  "description": "React hooks and components for the UniRate currency-exchange API. useExchangeRate, useCurrencies, useConvert, useHistoricalRate + <Currency/> and <Convert/> components. Zero runtime deps.",
  "type": "module",
  "license": "MIT",
  "author": "UniRate (https://unirateapi.com)",
  "homepage": "https://github.com/UniRate-API/react-unirate#readme",
  "bugs": "https://github.com/UniRate-API/react-unirate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniRate-API/react-unirate.git"
  },
  "keywords": [
    "react",
    "react-hook",
    "useExchangeRate",
    "unirate",
    "currency",
    "currency-converter",
    "exchange-rates",
    "forex",
    "fx",
    "money",
    "fintech"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
